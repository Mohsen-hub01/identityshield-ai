# IdentityShield AI local configuration
# Copy to .env and replace every placeholder.

IDENTITYSHIELD_SECRET_KEY=replace-with-a-long-random-secret

IDENTITYSHIELD_ADMIN_USERNAME=admin
IDENTITYSHIELD_ADMIN_PASSWORD=replace-me

IDENTITYSHIELD_ANALYST_USERNAME=analyst
IDENTITYSHIELD_ANALYST_PASSWORD=replace-me

IDENTITYSHIELD_VIEWER_USERNAME=viewer
IDENTITYSHIELD_VIEWER_PASSWORD=replace-me

# OpenRouter is only needed for the grounded RAG answer endpoint (/ask).
OPENROUTER_API_KEY=
IDENTITYSHIELD_LLM_MODEL=openai/gpt-4o-mini

# Optional: allow the MCP human-review tool. Disabled by default.
IDENTITYSHIELD_ENABLE_MCP_REVIEW_TOOL=false
